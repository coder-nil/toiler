{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Toiler 主窗口的最小权限集。core:window:allow-start-dragging 与 core:window:allow-internal-toggle-maximize 是标题栏拖拽/双击缩放必需的：覆盖式标题栏下系统不提供拖拽区，拖动由页面上的 data-tauri-drag-region 发起，缺这两条权限时会静默失败。",
  "windows": ["main"],
  "remote": {
    "urls": ["http://127.0.0.1:*", "http://localhost:*"]
  },
  "permissions": [
    "notification:default",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "allow-hide-startup-overlay",
    "allow-open-release-url",
    "allow-open-external-url",
    "allow-terminal-start",
    "allow-terminal-write",
    "allow-terminal-resize",
    "allow-terminal-close"
  ]
}
